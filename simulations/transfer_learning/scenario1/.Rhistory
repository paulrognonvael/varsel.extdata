library(RSpectra)
# helpers
is_pd <- function(x, w_offdiag) {
W <- build_W(w_offdiag, x)
ev <- tryCatch(eigs_sym(W, k = 1, which = "SA")$values[1], error = function(e) NA)
!is.na(ev) && ev > 0
}
build_W <- function(w_offdiag, x_diag) {
m <- (1 + sqrt(1 + 8 * length(w_offdiag))) / 2
stopifnot(m == floor(m))
W <- matrix(0, m, m)
W[upper.tri(W)] <- w_offdiag
W <- W + t(W)
diag(W) <- x_diag
W
}
#Tries to add scalar matrix to W[0] to make it close to inverse correlation
starting_point <- function(w_offdiag) {
m <- (1 + sqrt(1 + 8 * length(w_offdiag))) / 2
W0 <- build_W(w_offdiag, rep(0, m))
#  alpha <- solve_root(eigen(W0,symmetric=TRUE,only.values=TRUE)$values)
#  x0 <- rep(alpha, m)
lam0 <- eigs_sym(W0, k = 1, which = "SA")$values[1]
x0 <- rep(-lam0+1/m,m)
return(x0)
}
objective <- function(x, w_offdiag) {
W <- build_W(w_offdiag, x)
sum(x) - determinant(W, logarithm = TRUE)$modulus[1]
}
gradNhess <- function(x, w_offdiag) {
W <- build_W(w_offdiag, x)
W_inv <- solve(W)
return(list(g=rep(1, length(x)) - diag(W_inv),H=W_inv * W_inv))
}
newton_method <- function(w_offdiag, grad_tol = 0.1, max_iter = 500, step_reduction = 0.5) {
m <- (1 + sqrt(1 + 8 * length(w_offdiag))) / 2
x <- starting_point(w_offdiag)
for (iter in seq_len(max_iter)) {
derivs <- gradNhess(x, w_offdiag)
g <- derivs$g
H <- derivs$H
# Solve for Newton step direction
direction <- tryCatch(solve(H, -g), error = function(e) -g)
# Backtracking line search to maintain PD-ness
step_size <- 1
while (step_size > 1e-8) {
x_new <- x + step_size * direction
if (is_pd(x_new, w_offdiag)) break
step_size <- step_size * step_reduction
}
if (step_size <= 1e-8) {
warning("Failed to find a feasible step at iteration ", iter)
break
}
x <- x_new
max_abs_grad <- max(abs(gradNhess(x, w_offdiag)$g))
#   cat(sprintf("Iter %d: max(abs(grad)) = %.5f, step_size = %.5f\n", iter, max_abs_grad, step_size))
if (max_abs_grad < grad_tol) {
#    cat("Converged.\n")
break
}
}
list(
x = x,
value = objective(x, w_offdiag),
gradient = gradNhess(x, w_offdiag)$g,
W = build_W(w_offdiag, x)
)
}
benchmark_newton_method <- function(m = 100, n_runs = 100, grad_tol = 1e-3, mean=0, sd=sqrt(1)) {
times <- numeric(n_runs)
for (i in seq_len(n_runs)) {
n_offdiag <- m * (m - 1) / 2
w_offdiag <- rnorm(n_offdiag, mean = mean, sd = sd)
t_start <- proc.time()[["elapsed"]]
result <- newton_method(w_offdiag, grad_tol = grad_tol)
t_end <- proc.time()[["elapsed"]]
times[i] <- t_end - t_start
cat(sprintf("Run %3d: max(abs(grad)) = %.5f, time = %.3f sec\n",
i, max(abs(result$gradient)), times[i]))
}
avg_time <- mean(times)
cat(sprintf("\nAverage runtime over %d runs: %.3f sec\n", n_runs, avg_time))
invisible(times)
}
set.seed(123)
#benchmark_newton_method(m = 500, n_runs = 3, grad_tol = 1e-3,mean=0,sd=sqrt(1))
########### Uniform sampling
volume_elliptope <- function(m) {
if (m < 2) stop("m must be at least 2")
k_vals <- 1:(m - 1)
prod(sapply(k_vals, function(k) pi^(k / 2) / gamma(k / 2 + 1)))
}
construct_W <- function(w_offdiag){
return(newton_method(w_offdiag)$W)
}
# Final function: compute the desired scalar
evaluate_density <- function(w) {
W <- construct_W(w)
m <- nrow(W)
Winv <- solve(W)
return((volume_elliptope(m)*det(Winv)^(m+1)) / ( det(Winv*Winv)))
}
mcmc_sampler <- function(evaluate_density, w0, n_samples = 10000,
initial_sd = 0.1, target_accept = 0.3,
adapt_every = 100, burn_in = 1000,
min_sd = 1e-4, max_sd = 1.0) {
d <- length(w0)
samples <- matrix(NA, nrow = n_samples, ncol = d)
w <- w0
f_w <- tryCatch(evaluate_density(w), error = function(e) NA)
proposal_sd <- rep(initial_sd, d)
accept_count <- 0
for (i in 1:(n_samples + burn_in)) {
# Propose new point
proposal <- w + rt(d, ncp = 0, df = 1)
f_proposal <- tryCatch(evaluate_density(proposal), error = function(e) NA)
# Metropolis-Hastings acceptance
if (!is.na(f_proposal) && !is.na(f_w)) {
accept_prob <- min(1, f_proposal / f_w)
} else {
accept_prob <- 0
}
if (runif(1) < accept_prob) {
w <- proposal
f_w <- f_proposal
accept_count <- accept_count + 1
}
# Store sample after burn-in
if (i > burn_in) {
samples[i - burn_in, ] <- w
}
# Adapt proposal every `adapt_every` steps
if (i %% adapt_every == 0 && i <= burn_in) {
accept_rate <- accept_count / adapt_every
scaling_factor <- if (accept_rate > 0) accept_rate / target_accept else 0.5
proposal_sd <- pmin(pmax(proposal_sd * scaling_factor, min_sd), max_sd)
accept_count <- 0  # reset count
}
}
return(samples)
}
# Step 1: Transform samples (each row is a w vector) to corresponding correlation matrix off-diagonals
w_to_R_offdiag <- function(w) {
W <- tryCatch(construct_W(w), error = function(e) return(NULL))
if (is.null(W)) return(rep(NA, 3))
R <- tryCatch(solve(W), error = function(e) return(rep(NA, 3)))
if (is.null(R)) return(rep(NA, 3))
return(c(R[1,2], R[1,3], R[2,3]))
}
#######################
set.seed(42)
w0 <- c(0, 0, 0)  # A reasonable starting point
samples <- mcmc_sampler(evaluate_density, w0,
n_samples = 1000, initial_sd = 10)
# Look at results
# Get min and max for each coordinate
xlim <- range(samples[, 1])
ylim <- range(samples[, 2])
zlim <- range(samples[, 3])
pairs(samples, main = "MCMC samples from evaluate_density(w)")
