} else {
accept_prob <- 0
}
if (runif(1) < accept_prob) {
w <- proposal
f_w <- f_proposal
accept_count <- accept_count + 1
}
# Store sample after burn-in
if (i > burn_in) {
samples[i - burn_in, ] <- w
}
# Adapt proposal every `adapt_every` steps
if (i %% adapt_every == 0 && i <= burn_in) {
accept_rate <- accept_count / adapt_every
scaling_factor <- if (accept_rate > 0) accept_rate / target_accept else 0.5
proposal_sd <- pmin(pmax(proposal_sd * scaling_factor, min_sd), max_sd)
accept_count <- 0  # reset count
}
}
return(samples)
}
# Step 1: Transform samples (each row is a w vector) to corresponding correlation matrix off-diagonals
w_to_R_offdiag <- function(w) {
W <- tryCatch(construct_W(w), error = function(e) return(NULL))
if (is.null(W)) return(rep(NA, 3))
R <- tryCatch(solve(W), error = function(e) return(rep(NA, 3)))
if (is.null(R)) return(rep(NA, 3))
return(c(R[1,2], R[1,3], R[2,3]))
}
